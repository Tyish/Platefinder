SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql+psycopg2://numberplates:numberplates@127.0.0.1:5432/numberplates
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# YOLO (optional — pip install -r requirements-yolo.txt)
# YOLO_MODEL_PATH=/path/to/license_plate_detector.pt
# YOLO_CONFIDENCE=0.35

# Email alerts (SMTP)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
NOTIFY_EMAIL_TO=security@example.com

# SMS alerts (Twilio)
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NOTIFY_SMS_TO=+254700000000
